#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
	local devices device debug seen=" "
	config_load lggl
	config_get devices main interfaces
	config_get_bool debug main debug 0
	for device in $devices; do
		case "$device" in
			*[!a-zA-Z0-9_.:-]*|.|..|'') continue ;;
		esac
		[ "${#device}" -lt 16 ] || continue
		case "$seen" in *" $device "*) continue ;; esac
		seen="$seen$device "
		procd_open_instance "$device"
		procd_set_param command /usr/sbin/lggld "$device"
		[ "$debug" -eq 1 ] && procd_append_param command --debug
		procd_set_param respawn 3600 5 0
		procd_set_param netdev "$device"
		procd_close_instance
	done
}

service_triggers() {
	procd_add_reload_trigger lggl
	procd_open_trigger
	procd_add_raw_trigger "interface.*" 1000 /etc/init.d/lggl reload
	procd_close_trigger
}
